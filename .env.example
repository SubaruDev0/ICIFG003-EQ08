# ============================================================
# EJEMPLO DE VARIABLES DE ENTORNO
# Copiar este archivo como .env y completar con valores reales
# La URL de Neon ya incluye usuario y contraseña adentro
# ============================================================

# --- BASE DE DATOS (Neon PostgreSQL) ---
# Copiar el "JDBC URL" desde el panel de Neon (ya trae user y password en la URL)
DB_URL=jdbc:postgresql://ep-XXXXXX.us-east-2.aws.neon.tech/neondb?user=USUARIO&password=PASSWORD&sslmode=require&channelBinding=require

# --- PUERTO DEL BACKEND ---
PORT=6789
